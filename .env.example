# ASTRA-X Environment Configuration

# Enable demo data mode for uncomputed/demo states (default: false)
ASTRAX_DEMO_MODE=false

# SQLite Database connection string
DATABASE_URL=sqlite:///./astrax.db

# Earthdata Credentials (optional, for Phase 4 DEM ingestion)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Optional LLM integration (for future AI interpretation phases)
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Frontend API URL configuration
VITE_API_URL=http://localhost:8000
